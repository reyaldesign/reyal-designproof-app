generator client {
  provider = "prisma-client-js"
}

// SQLite keeps the VPS to one container. To move to Postgres, change provider and DATABASE_URL, then re-run migrate.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String?
  notes     String?
  // How many revision rounds each of this client's proofs includes. A proof can override it.
  revisionsIncluded Int @default(2)
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Project {
  id        String    @id @default(cuid())
  slug      String    @unique
  title     String
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status    String    @default("Draft") // Draft | Sent | Feedback Received | Approved
  password  String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  // Set when the client approves. The approved version is locked from further comments.
  approvedAt      DateTime?
  approvedBy      String?
  approvedVersion Int?
  revisionsIncluded Int? // blank means use the client's number
  type      String? // website | social | menu | print. Empty on proofs made before types existed.
  versions  Version[]
  submissions Submission[]
}

model Version {
  id        String    @id @default(cuid())
  projectId String
  number    Int
  label     String
  createdAt DateTime  @default(now())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  images    Image[]
  comments  Comment[]
  submissions Submission[]

  @@unique([projectId, number])
}

model Image {
  id        String    @id @default(cuid())
  versionId String
  file      String
  position  Int
  version   Version   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  comments  Comment[]
}

// One press of "Send now" by the client. Each one uses up one revision.
model Submission {
  id        String    @id @default(cuid())
  projectId String
  versionId String
  number    Int
  author    String
  createdAt DateTime  @default(now())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version   Version   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  comments  Comment[]

  @@unique([projectId, number])
}

model Comment {
  id           String    @id @default(cuid())
  versionId    String
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  imageId      String?
  parentId     String?
  author       String
  text         String
  x            Float?
  y            Float?
  pin          Int?
  resolved     Boolean   @default(false)
  fromDesigner Boolean   @default(false)
  createdAt    DateTime  @default(now())
  version      Version   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  image        Image?    @relation(fields: [imageId], references: [id], onDelete: SetNull)
  parent       Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[] @relation("Replies")
}
