generator client {
  provider = "prisma-client-js"
}

// SQLite keeps the VPS to one container. To move to Postgres, change provider and DATABASE_URL, then re-run migrate.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String?
  notes     String?
  // How many revision rounds each of this client's proofs includes. A proof can override it.
  revisionsIncluded Int @default(2)
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Project {
  id        String    @id @default(cuid())
  slug      String    @unique
  title     String
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status    String    @default("Draft") // Draft | Sent | Feedback Received | Approved
  password  String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  // Set when the client approves. The approved version is locked from further comments.
  approvedAt      DateTime?
  approvedBy      String?
  approvedVersion Int?
  revisionsIncluded Int? // blank means use the client's number
  type      String? // website | social | menu | print. Empty on proofs made before types existed.
  versions  Version[]
  submissions Submission[]
}

model Version {
  id        String    @id @default(cuid())
  projectId String
  number    Int
  label     String
  createdAt DateTime  @default(now())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  images    Image[]
  comments  Comment[]
  submissions Submission[]

  @@unique([projectId, number])
}

model Image {
  id        String    @id @default(cuid())
  versionId String
  file      String
  position  Int
  version   Version   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  comments  Comment[]
}

// One press of "Send now" by the client. Each one uses up one revision.
model Submission {
  id        String    @id @default(cuid())
  projectId String
  versionId String
  number    Int
  author    String
  createdAt DateTime  @default(now())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version   Version   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  comments  Comment[]

  @@unique([projectId, number])
}

model Comment {
  id           String    @id @default(cuid())
  versionId    String
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  imageId      String?
  parentId     String?
  author       String
  text         String
  x            Float?
  y            Float?
  pin          Int?
  resolved     Boolean   @default(false)
  fromDesigner Boolean   @default(false)
  createdAt    DateTime  @default(now())
  version      Version   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  image        Image?    @relation(fields: [imageId], references: [id], onDelete: SetNull)
  parent       Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[] @relation("Replies")
}

// ---------------------------------------------------------------------------
// AI Reviewer. A separate tool: these tables have no relation to Client, Project or any proofing table.
// ---------------------------------------------------------------------------
model AiClient {
  id         String       @id @default(cuid())
  name       String
  notes      String?
  logoFile   String? // the client's icon, stored in uploads/ai
  createdAt  DateTime     @default(now())
  categories AiCategory[]
  criteria   AiCriterion[]
  reviews    AiReview[]
}

model AiCategory {
  id        String        @id @default(cuid())
  clientId  String
  name      String
  position  Int           @default(0)
  client    AiClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  criteria  AiCriterion[]
  reviews   AiReview[]
}

// A criterion with no category applies to every category of the client.
model AiCriterion {
  id         String      @id @default(cuid())
  clientId   String
  categoryId String?
  text       String
  position   Int         @default(0)
  client     AiClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category   AiCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

// Names are copied onto the review, so history stays readable if a client or category is later renamed or deleted.
model AiReview {
  id               String      @id @default(cuid())
  clientId         String?
  clientName       String?
  categoryId       String?
  categoryName     String?
  originalFilename String
  imageFile        String
  score            Int
  verdict          String // approved | needs_review | rejected
  summary          String      @default("")
  actionItems      String      @default("[]") // JSON array of strings
  checks           String      @default("[]") // JSON array of { criterion, status, comment, location? }
  criteriaSnapshot String      @default("[]") // JSON array of the criteria used
  inputTokens      Int         @default(0)
  outputTokens     Int         @default(0)
  createdAt        DateTime    @default(now())
  client           AiClient?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  category         AiCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// ----- Team & access -----
// role: ADMIN | PM | DESIGNER (null while pending). status: PENDING | ACTIVE | SUSPENDED | DENIED.
model User {
  id           String             @id @default(cuid())
  email        String             @unique
  name         String             @default("")
  role         String?
  status       String             @default("PENDING")
  createdAt    DateTime           @default(now())
  lastSignInAt DateTime?
  sessions     Session[]
  overrides    UserToolOverride[]
  clickup      ClickupToken?
}

// Each person's own ClickUp OAuth token, encrypted with a key derived from SESSION_SECRET. Deleted with the user.
model ClickupToken {
  userId    String   @id
  token     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per signed-in browser. The cookie holds the id, so deleting the row signs that browser out right away.
model Session {
  id         String   @id
  userId     String
  userAgent  String   @default("")
  ip         String   @default("")
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One row per switched-on cell in the Roles grid.
model RolePermission {
  role String
  tool String

  @@id([role, tool])
}

// A tool given to (granted) or taken from (not granted) one person, on top of their role.
model UserToolOverride {
  userId  String
  tool    String
  granted Boolean
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tool])
}

// kind: SIGNED_IN | SIGNED_OUT | FIRST_SIGN_IN | BLOCKED_DOMAIN | BLOCKED_SUSPENDED | BLOCKED_DENIED | BLOCKED_PASSWORD | ACCESS_CHANGED | ACCESS_REQUESTED
model SignInEvent {
  id        String   @id @default(cuid())
  email     String
  kind      String
  detail    String   @default("")
  userAgent String   @default("")
  ip        String   @default("")
  actor     String? // the admin who made an access change
  at        DateTime @default(now())

  @@index([at])
}
