# Copy to .env and fill in. Never commit .env.
DATABASE_URL="file:../data/app.db"
DATA_DIR="./data"
SESSION_SECRET="change-me-to-a-long-random-string"
# First admin. Its email + password login always works and always ends up an admin (the way back in if roles go wrong).
ADMIN_EMAIL="you@reyaldesign.com"
ADMIN_PASSWORD="change-me"
# Public base URL used in emails and share links
APP_URL="http://localhost:3100"
# Optional. Without SMTP_HOST, notifications are logged to the console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Reyal Design Studio <proof@reyaldesign.com>"
NOTIFY_EMAIL=""

# Google sign-in for designers (optional). Create an OAuth client in Google Cloud Console (type: Web application)
# with the redirect URI  <APP_URL>/api/auth/google/callback . The button appears once both are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Who may sign in with Google: everyone on this domain, plus any extra addresses listed.
ALLOWED_EMAIL_DOMAIN="reyaldesign.com"
ALLOWED_EMAILS=""

# AI Reviewer (optional). The whole tool is hidden unless AI_REVIEWER_ENABLED is "true".
AI_REVIEWER_ENABLED="false"
# Get a key at https://console.anthropic.com (Settings, API Keys). Billing must be set up there, and a monthly spend limit is recommended.
ANTHROPIC_API_KEY=""
AI_REVIEWER_MODEL="claude-sonnet-5"
# How thorough the model is: low, medium, high, xhigh, max. Raise AI_REVIEWER_MAX_TOKENS a lot if you use xhigh or max.
AI_REVIEWER_EFFORT="high"
AI_REVIEWER_MAX_TOKENS="8192"
# Used only for the cost estimate on the review screen.
PRICE_PER_MTOK_INPUT="2.0"
PRICE_PER_MTOK_OUTPUT="10.0"
# How many images are sent to Claude at the same time.
AI_MAX_CONCURRENT="3"
